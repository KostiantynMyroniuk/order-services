{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Kestrel": {
    "Endpoints": {
      "RestEndpoint": {
        "Url": "http://*:8080",
        "Protocols": "Http1"
      },
      "GrpcEndpoint": {
        "Url": "http://*:8081",
        "Protocols": "Http2"
      }
    }
  },

  "AllowedHosts": "*"
}
